# Base de données (Postgres 16)
DATABASE_URL=pglite://./data/dev
# (production : postgres://user:mdp@hote:5432/applybot)
# Session : ≥ 32 caractères aléatoires, jamais commité
JWT_SECRET=
NODE_ENV=development
# Nombre de reverse proxies de confiance en amont (Coolify/Traefik...), qui ajoutent chacun une
# adresse en fin de x-forwarded-for. Détermine quelle adresse de x-forwarded-for est retenue pour
# la limite anti-flood par IP (lib/rate-limit.ts, getClientIp) : 0 = adresse cliente inconnue depuis
# l'appli, limite par IP désactivée (dev direct, sans proxy). 1 = derrière un seul reverse proxy
# (Coolify/Traefik en prod). Ne jamais faire confiance à x-forwarded-for sans proxy de confiance
# déclaré : n'importe quel client peut le forger.
TRUSTED_PROXY_HOPS=0
# Sources d'offres (facultatives : une source sans clé est simplement désactivée)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
JOOBLE_API_KEY=
LBA_API_KEY=
SOURCE_LBA=on
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_TOKENS=
SMARTRECRUITERS_COMPANY_TOKENS=

# Compte de démonstration (facultatif)
#
# Renseignés, ils ouvrent la page /demo : un visiteur venu du portfolio entre
# dans un compte d'exemple en un clic, sans inscription ni code d'organisme.
# Absents, la page affiche simplement que la démonstration n'est pas ouverte.
#
# Les identifiants sont AFFICHÉS sur la page : le compte ne contient que des
# données fictives. Ne jamais y mettre ceux d'un vrai compte.
# Le jeu de données se crée et se remet à zéro avec `npm run seed-demo` en local,
# `node dist/scripts/seed-demo.cjs` dans le conteneur de production.
DEMO_EMAIL=
DEMO_PASSWORD=
